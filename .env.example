# ---------------------------------------------------------------------------
# Revnu — local environment. NEVER commit this file (it is git-ignored).
# ---------------------------------------------------------------------------

# Supabase project (client-created; do not create a new one)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Management API token — CLI / one-time setup ONLY (migrations, auth config).
# Never referenced by application runtime code.
SUPABASE_ACCESS_TOKEN=

# Server-only. Needed by: scripts/seed-users.mjs, /api/users (invites, resets).
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for `supabase link` / `supabase db push` (Management API is used otherwise).
SUPABASE_DB_PASSWORD=

# Email. MAIL_MODE=log writes notifications to the DB outbox without sending.
# Switch to MAIL_MODE=resend + RESEND_API_KEY at the domain-cutover step.
MAIL_MODE=log
RESEND_API_KEY=
MAIL_FROM="Revnu <onboarding@resend.dev>"

# Public origin of this deployment (used in emails / redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
